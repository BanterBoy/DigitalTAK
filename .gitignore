# ── Certificate and key material — NEVER commit ────────────────────────────
# PKCS12 keystores (user/server certs, truststore)
*.p12
*.pfx
# JKS keystores
*.jks
# PEM keys and certs
*.key
*.pem
*.crt
*.cer
# ATAK data packages (embed .p12 files; distribute out-of-band only)
dist/
# Downloaded cert staging directories
certs/*/
# Safety net: never commit admin PFX regardless of location
admin.p12

# ── Deployment reports contain credentials and must never be committed ──────
reports/DEPLOYMENT-REPORT-*.md

# Integration test XML results
reports/TestResults-Integration.xml

# Docker Compose secrets (see docker/.gitignore for details)
docker/.env

# ── TAK Server RPM and GPG key (binary content, NOT included in repo) ──────
# These files MUST be downloaded manually from https://tak.gov
# A TAK.gov account with MFA is required to access the downloads portal.
# Never commit these files — they are too large for GitHub (>100 MB) and
# are subject to TAK Server distribution restrictions.
takserver-*.noarch.rpm
takserver-*.rpm
takserver-public-gpg.key

# Official TAK Server Docker release package (binary content, download from tak.gov)
# Extract takserver-docker-5.7-RELEASE-8.zip here before building.
takserver-docker-5.7-RELEASE-8/
