# DigitalTAK -- Docker Compose Environment
# cp .env.example .env  then fill in the values below.
# SECURITY: Never commit .env -- it is excluded by .gitignore.

# Database password.
# Used by the DB container (takserver-setup-db.sh) to create the martiuser role,
# and by the TAK Server container to connect to PostgreSQL.
TAK_DB_PASSWORD=CHANGE_ME_strong_db_password

# Certificate metadata -- consumed by init-certs.sh run via docker exec.
TAK_CERT_STATE=VA
TAK_CERT_CITY=ARLINGTON
TAK_CERT_ORG=MYORG
TAK_CERT_OU=MYUNIT
TAK_CERT_CA_NAME=TAK-CA
TAK_CERT_PASS=CHANGE_ME_cert_password

# Host-side port mappings (change if defaults conflict with other services).
TAK_PORT_COT=8089
TAK_PORT_WEB=8443
TAK_PORT_ENROLL=8446