# DigitalTAK – Docker Compose Environment Configuration
#
# Usage:
#   cp .env.example .env
#   Edit .env with your values before running `docker compose up`
#
# SECURITY: Never commit .env to version control. It contains secrets.
#           The .gitignore in this directory already excludes it.

# ── TAK Server RPM ─────────────────────────────────────────────────────────────
# Filename of the TAK Server RPM placed in this docker/ directory.
# Download from https://tak.gov (free account required).
TAK_RPM_FILENAME=takserver-5.7-RELEASE8.noarch.rpm

# Optional: GPG key filename for RPM signature verification (recommended).
# Download takserver-public-gpg.key from tak.gov alongside the RPM.
# Set to empty string to skip verification: TAK_GPG_KEY_FILENAME=
TAK_GPG_KEY_FILENAME=takserver-public-gpg.key

# ── Database ───────────────────────────────────────────────────────────────────
# These are used for both the postgres container AND the TAK Server connection.
# TAK_DB_PASSWORD is required — no default is provided.
TAK_DB_NAME=cot
TAK_DB_USER=martiuser
TAK_DB_PASSWORD=CHANGE_ME_strong_db_password
TAK_DB_PORT=5432

# ── Certificate Metadata ───────────────────────────────────────────────────────
# Used when generating the TAK Server CA chain on first startup.
# All values MUST be UPPERCASE with no spaces — letters, digits, and hyphens only.
# These values are embedded in certificate subject fields (DN).
TAK_CERT_STATE=VA
TAK_CERT_CITY=ARLINGTON
TAK_CERT_ORG=MYORG
TAK_CERT_OU=MYUNIT
TAK_CERT_CA_NAME=TAK-CA

# Keystore password for all generated JKS/P12 files.
# TAK Server uses this to unlock certificate keystores at runtime.
# Required — must be non-empty.
TAK_CERT_PASS=CHANGE_ME_strong_cert_password

# ── Admin Certificate ──────────────────────────────────────────────────────────
# Common name for the admin client certificate.
# The resulting admin.p12 must be imported into a browser to access WebTAK admin UI.
TAK_ADMIN_CERT_NAME=admin

# ── Network Ports ──────────────────────────────────────────────────────────────
# Host-side port mappings. Change these if the defaults conflict with other services.
TAK_PORT_COT=8089       # TAK CoT client connections (TLS)
TAK_PORT_WEB=8443       # WebTAK, REST API, Admin console (HTTPS)
TAK_PORT_ENROLL=8446    # Certificate enrollment (HTTPS)

# ── Initial User Groups ────────────────────────────────────────────────────────
# Comma-separated list of groups to create via the TAK Server REST API
# after the first successful startup.
# Default: Alpha and Bravo (two-team baseline configuration).
TAK_INIT_GROUPS=Alpha,Bravo
